/* 小牛育儿 v4.0 - 全局样式 */

/* 主题变量 */
page {
  --primary: #2F9D8E;
  --primary-light: #79C8BA;
  --primary-bg: #E8F5F1;
  --accent: #C58A52;
  --text: #283936;
  --text-secondary: #657773;
  --text-muted: #99AAA5;
  --bg: #F7F7F2;
  --white: #FFFFFF;
  --surface-soft: #F0F3EE;
  --border: #DDE8E3;
  --radius-card: 28rpx;
  --radius-control: 18rpx;
  --shadow-card: 0 10rpx 30rpx rgba(54, 83, 75, 0.08);
  
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text);
  background: var(--bg);
  min-height: 100vh;
}

text,
view,
button,
input,
textarea {
  box-sizing: border-box;
}

text,
button,
input,
textarea {
  letter-spacing: 0;
  overflow-wrap: break-word;
}

text {
  line-height: inherit;
}

/* 通用容器 */
.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: var(--white);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

/* 按钮 */
.btn {
  min-height: 88rpx;
  line-height: 1.45;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
}

.btn-primary {
  background: var(--primary);
  color: var(--white);
}

/* 统一跨页面视觉基线 */
.page,
.membership-page {
  background: var(--bg) !important;
  color: var(--text);
}

.page-header,
.header,
.user-section,
.membership-card,
.core-hero-content {
  background: var(--primary-bg) !important;
  color: var(--text) !important;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card) !important;
  box-shadow: var(--shadow-card);
}

.page-header .page-title,
.page-header .page-subtitle,
.header .title,
.header .subtitle,
.user-section .user-name,
.user-section .user-id,
.user-section .user-phone,
.membership-card .membership-title,
.membership-card .membership-type,
.membership-card .membership-days,
.membership-card .membership-tip {
  color: var(--text) !important;
}

.page-header .page-subtitle,
.header .subtitle,
.header .source-tip,
.membership-card .membership-days,
.membership-card .membership-tip {
  opacity: 1 !important;
  color: var(--text-secondary) !important;
}

.auth-primary-btn,
.primary-btn,
.btn-pay,
.btn-share,
.core-primary-action,
.service-action,
.option-chip-active,
.filter-chip-active {
  background: var(--primary) !important;
  color: var(--white) !important;
  border-color: var(--primary) !important;
  border-radius: var(--radius-control) !important;
}

.auth-secondary-btn,
.secondary-btn,
.btn-secondary,
.service-action.secondary,
.summary-badge-soft,
.option-chip,
.filter-chip {
  background: var(--surface-soft) !important;
  color: var(--text-secondary) !important;
  border-color: var(--border) !important;
  border-radius: var(--radius-control) !important;
}

.plans-section,
.promo-section,
.referral-section,
.summary-card,
.content-card,
.hero-card,
.section-card,
.empty-card,
.auth-card,
.child-entry,
.ai-intro,
.zone-card,
.featured-item,
.pain-point-card,
.guide-card,
.training-card,
.assessment-card,
.record-card,
.history-card {
  background: var(--white) !important;
  border-color: var(--border) !important;
  border-radius: var(--radius-card) !important;
  box-shadow: var(--shadow-card);
}

.search-input-wrap,
.note-box,
input,
textarea {
  background: var(--surface-soft) !important;
  border-color: var(--border) !important;
  border-radius: var(--radius-control) !important;
  color: var(--text) !important;
}

.section-title,
.hero-title,
.summary-title,
.content-title,
.plan-name,
.auth-title,
.zone-title,
.featured-title,
.guide-title,
.training-title,
.assessment-title {
  color: var(--text) !important;
  font-weight: 700;
}

.subtitle,
.summary-copy,
.helper-copy,
.content-summary,
.auth-desc,
.zone-subtitle,
.featured-action,
.guide-desc,
.section-subtext {
  color: var(--text-secondary) !important;
}

.page-header::before,
.page-header::after,
.header::before,
.header::after {
  display: none;
}

.btn-secondary {
  background: var(--white);
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

/* 标题 */
.title {
  font-size: 36rpx;
  line-height: 1.45;
  font-weight: 700;
  color: var(--text);
}

.subtitle {
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--text-secondary);
}

/* 模块图标 */
.module-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

/* 网格布局 */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 500;
}

.tag-primary {
  background: var(--primary-bg);
  color: var(--primary);
}

.tag-accent {
  background: #FFF8E1;
  color: var(--accent);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: var(--text-muted);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--text-muted);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* ========== 性能优化通用样式 ========== */

/* 骨架屏动画 */
@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

.skeleton-text {
  height: 28rpx;
  margin-bottom: 16rpx;
}

.skeleton-title {
  height: 40rpx;
  width: 60%;
  margin-bottom: 20rpx;
}

.skeleton-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.skeleton-image {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
}

.skeleton-card {
  background: var(--white);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 统一加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

/* 页面过渡动画 */
.page-transition {
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 列表项进入动画 */
.list-item-enter {
  animation: slideInUp 0.3s ease-out;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 图片占位符 */
.image-placeholder {
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 48rpx;
}

/* 图片淡入效果 */
.image-fade-in {
  opacity: 0;
  transition: opacity 0.3s ease;
}

.image-fade-in.loaded {
  opacity: 1;
}

/* 优化滚动性能 */
.scroll-view-optimized {
  will-change: transform;
  -webkit-overflow-scrolling: touch;
}

/* 防止重绘优化 */
.gpu-accelerated {
  transform: translateZ(0);
  backface-visibility: hidden;
}
