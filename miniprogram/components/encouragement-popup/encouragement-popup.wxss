.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 86%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: visible;
  animation: modalIn 0.35s ease;
  position: relative;
  padding: 60rpx 40rpx 40rpx;
  border: 1rpx solid #ECEFEB;
  box-shadow: 0 8rpx 32rpx rgba(106, 174, 152, 0.12);
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.85);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.modal-glow {
  position: absolute;
  top: -1rpx;
  left: 30rpx;
  right: 30rpx;
  height: 8rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: #DDEDE5;
}

.level-1 .modal-glow {
  background: #DDEDE5;
}
.level-2 .modal-glow {
  background: #DDEBF3;
}
.level-3 .modal-glow {
  background: #F5E8BC;
}
.level-4 .modal-glow {
  background: #E7DDF2;
}
.level-5 .modal-glow {
  background: #F3DFE3;
}

.modal-icon-area {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.modal-icon {
  font-size: 80rpx;
  line-height: 1;
}

.modal-body {
  text-align: center;
  padding: 0 8rpx 32rpx;
}

.modal-message {
  font-size: 34rpx;
  font-weight: 600;
  color: #2F3432;
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.level-4 .modal-message,
.level-5 .modal-message {
  font-size: 36rpx;
  color: #2F3432;
}

.level-5 .modal-message {
  font-weight: 700;
}

.modal-footer {
  display: flex;
  justify-content: center;
}

.confirm-btn {
  width: 320rpx;
  min-height: 80rpx;
  line-height: 1.45;
  background: #6AAE98;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 18rpx 20rpx;
  text-align: center;
  box-sizing: border-box;
}

.confirm-btn::after {
  border: none;
}

.level-4 .confirm-btn {
  background: #F28C72;
}

.level-5 .confirm-btn {
  background: #F28C72;
}

.level-5 .modal-container {
  box-shadow: 0 8rpx 32rpx rgba(106, 174, 152, 0.12);
}
