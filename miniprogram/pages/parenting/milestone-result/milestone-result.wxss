.page-container {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 120rpx;
}

.header {
  background: #E6F7ED;
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  color: #FFFFFF;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  line-height: 1.35;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.6;
}

.history-list {
  padding: 30rpx;
}

.history-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-age {
  font-size: 32rpx;
  font-weight: 700;
  color: #2F3432;
  line-height: 1.45;
}

.history-date {
  font-size: 24rpx;
  color: #929995;
  line-height: 1.45;
}

.history-score {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #6AAE98;
  margin-right: 20rpx;
  line-height: 1.3;
}

.score-bar {
  flex: 1;
  height: 16rpx;
  background: #ECEFEB;
  border-radius: 8rpx;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  background: #6AAE98;
  border-radius: 8rpx;
}

.history-detail {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-text {
  font-size: 24rpx;
  color: #929995;
  line-height: 1.5;
}

.trend-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.trend-text.up {
  color: #4CAF50;
}

.trend-text.down {
  color: #E8737A;
}

.trend-text.neutral {
  color: #929995;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2F3432;
  margin-bottom: 12rpx;
  line-height: 1.45;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #929995;
  line-height: 1.65;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECEFEB;
  box-shadow: none;
}

.btn-primary {
  background: #6AAE98;
  color: #FFFFFF;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.btn-primary::after {
  border: none;
}
