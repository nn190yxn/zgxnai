/* 家长痛点合集页 */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.pp-header {
  padding: 8rpx 8rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pp-eyebrow {
  font-size: 24rpx;
  color: var(--primary, #397A68);
  letter-spacing: 2rpx;
}

.pp-title {
  font-size: 42rpx;
  font-weight: 600;
  color: var(--text, #2E3A34);
}

.pp-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary, #7A857E);
  line-height: 1.5;
}

/* 标签目录 */
.pp-tag-scroll {
  margin-bottom: 24rpx;
}

.pp-tag-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 4rpx 8rpx;
}

.pp-tag {
  flex: 0 0 auto;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: var(--white, #FFFFFF);
  border: 1rpx solid var(--border, #E4E7E4);
  font-size: 26rpx;
  color: var(--text-secondary, #5C6661);
}

.pp-tag-active {
  background: var(--primary, #397A68);
  border-color: var(--primary, #397A68);
  color: #FFFFFF;
  font-weight: 600;
}

/* 状态卡 */
.pp-state-card {
  margin: 40rpx 0;
  padding: 48rpx 32rpx;
  background: var(--white, #FFFFFF);
  border: 1rpx solid var(--border, #E4E7E4);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.pp-state-title {
  font-size: 30rpx;
  color: var(--text, #2E3A34);
}

.pp-state-desc {
  font-size: 24rpx;
  color: var(--text-secondary, #7A857E);
  line-height: 1.5;
}

.pp-retry {
  margin-top: 8rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: var(--primary, #397A68);
  color: #FFFFFF;
  font-size: 26rpx;
}

/* 骨架屏 */
.pp-skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pp-skeleton-card {
  padding: 28rpx;
  background: var(--white, #FFFFFF);
  border: 1rpx solid var(--border, #E4E7E4);
  border-radius: 24rpx;
}

.pp-skeleton-title {
  height: 36rpx;
  width: 62%;
  margin-bottom: 20rpx;
}

.pp-skeleton-line {
  height: 26rpx;
  width: 100%;
  margin-bottom: 14rpx;
}

.pp-skeleton-line-short {
  width: 48%;
  margin-bottom: 0;
}

/* 文章列表 */
.pp-article-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pp-article-card {
  padding: 28rpx;
  background: var(--white, #FFFFFF);
  border: 1rpx solid var(--border, #E4E7E4);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pp-article-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text, #2E3A34);
  line-height: 1.5;
}

.pp-article-summary {
  font-size: 26rpx;
  color: var(--text-secondary, #6B7570);
  line-height: 1.5;
}

.pp-article-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pp-article-tag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--primary-bg, #EAF3EF);
  color: var(--primary, #397A68);
  font-size: 22rpx;
}

/* 加载更多 */
.pp-load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: var(--text-secondary, #8A948E);
}

.loading-spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #EEEEEE;
  border-top-color: var(--primary, #6AAE98);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
