/* 孩子档案列表样式 */

.page {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 160rpx;
}

/* 顶部提示 */
.header-tip {
  background: #F5E8BC;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #FFE58F;
}

.tip-text {
  font-size: 24rpx;
  color: #D48806;
  line-height: 1.6;
}

/* 孩子列表 */
.children-list {
  padding: 24rpx 32rpx;
}

.child-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  position: relative;
  box-shadow: none;
}

.child-card:active {
  background: #FAF8F5;
}

/* 星标按钮 */
.star-btn {
  position: absolute;
  top: 16rpx;
  right: 60rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.star-icon {
  font-size: 40rpx;
  color: #929995;
}

.star-btn.active .star-icon {
  color: #FFB800;
}

/* 头像 */
.child-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #E6F7ED;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 50rpx;
}

/* 孩子信息 */
.child-info {
  flex: 1;
  min-width: 0;
}

.child-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  margin-bottom: 8rpx;
}

.child-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2F3432;
  line-height: 1.45;
}

.child-nickname {
  font-size: 26rpx;
  color: #929995;
  line-height: 1.45;
}

.default-badge {
  font-size: 20rpx;
  color: #FFFFFF;
  background: #6AAE98;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  line-height: 1.45;
}

.child-detail {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.detail-item {
  font-size: 26rpx;
  color: #626A66;
  line-height: 1.5;
}

.detail-divider {
  font-size: 26rpx;
  color: #929995;
  margin: 0 16rpx;
  line-height: 1.5;
}

/* 标签 */
.child-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #6AAE98;
  background: #F3DFE3;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.45;
}

/* 箭头 */
.arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 36rpx;
  color: #929995;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24rpx 32rpx;
  padding: 64rpx 40rpx;
  border: 1rpx solid #ECEFEB;
  border-radius: 28rpx;
  background: #FFFFFF;
}

.compact-error .empty-desc {
  margin-bottom: 32rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #2F3432;
  margin-bottom: 16rpx;
  line-height: 1.45;
}

.empty-desc {
  font-size: 26rpx;
  color: #929995;
  margin-bottom: 48rpx;
  text-align: center;
  line-height: 1.7;
}

.add-btn-primary {
  background: #6AAE98;
  color: #FFFFFF;
  font-size: 30rpx;
  padding: 24rpx 80rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1.45;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #929995;
  line-height: 1.6;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border: 1rpx solid #ECEFEB;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.add-btn {
  width: 100%;
  background: #6AAE98;
  color: #FFFFFF;
  font-size: 30rpx;
  padding: 24rpx 0;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.45;
}

.add-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.add-text {
  font-size: 30rpx;
  line-height: 1.45;
}

.count-tip {
  font-size: 24rpx;
  color: #929995;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* 上限提示 */
.max-tip {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #F5E8BC;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.max-tip-text {
  font-size: 26rpx;
  color: #D48806;
  line-height: 1.6;
}
