<view class="page">
  <view class="header">
    <text class="eyebrow">3-6 岁发展专区</text>
    <text class="title">先选发展方向，再看具体场景</text>
    <text class="subtitle">先从专注力和感觉运动开始，再按需要查看其他发展方向。生长管理和身体安全专题提供连续的家庭支持。</text>
    <text class="source-tip" wx:if="{{isFallback}}">当前使用本地内容，联网后会优先更新正式内容。</text>
  </view>

  <view class="featured-row" wx:if="{{featuredZones.length}}">
    <text class="featured-label">先从这两个方向开始</text>
    <view class="featured-list">
      <view class="featured-item" wx:for="{{featuredZones}}" wx:key="code" data-zone="{{item.code}}" bindtap="openZone">
        <text class="featured-title">{{item.title}}</text>
        <text class="featured-action">{{item.actionText}}</text>
      </view>
    </view>
  </view>

  <view class="zone-grid">
    <view wx:for="{{zones}}" wx:key="code" class="zone-card" data-zone="{{item.code}}" bindtap="openZone" style="border-color: {{item.color}}; background: {{item.tint}};">
      <view class="zone-card-head">
        <text class="zone-title">{{item.title}}</text>
        <text class="zone-arrow">></text>
      </view>
      <text class="zone-badge" wx:if="{{item.isPrimary}}">首要方向</text>
      <text class="zone-badge zone-badge-premium" wx:elif="{{item.isPremiumTopic}}">会员专题</text>
      <text class="zone-subtitle">{{item.subtitle}}</text>
      <view class="zone-meta-row">
        <text class="zone-meta">{{item.scenarioCount}} 个场景</text>
        <text class="zone-action">{{item.actionText}}</text>
      </view>
    </view>
  </view>

  <view class="pain-point-card">
    <view class="section-head">
      <text class="featured-label">从具体表现开始</text>
      <text class="source-tip">{{painPointSource === 'server' ? '正式内容' : '当前使用本地备用内容'}}</text>
    </view>
    <view class="filter-row">
      <view class="filter-chip {{!painPointCategory ? 'filter-chip-active' : ''}}" data-category="" bindtap="selectPainPointCategory">全部</view>
      <view class="filter-chip" data-category="attention_learning" bindtap="selectPainPointCategory">做事与学习</view>
      <view class="filter-chip" data-category="emotion_rules" bindtap="selectPainPointCategory">情绪与配合</view>
      <view class="filter-chip" data-category="social_expression" bindtap="selectPainPointCategory">说话与相处</view>
    </view>
    <view class="pain-point-list">
      <view class="pain-point-item" wx:for="{{painPoints}}" wx:key="key" wx:if="{{!painPointCategory || item.category === painPointCategory || item.categoryKey === painPointCategory}}" data-key="{{item.key}}" bindtap="openPainPoint">
        <text class="pain-point-title">{{item.title}}</text>
        <text class="pain-point-desc">{{item.description}}</text>
        <text class="pain-point-link">看原因、今天做和记录变化 ></text>
      </view>
    </view>
    <view class="empty-card" wx:if="{{!painPoints.length}}">暂时没有可展示的成长痛点，先问小牛获得支持。</view>
  </view>

  <view class="guide-card">
    <text class="guide-title">进入后怎么看</text>
    <text class="guide-desc">先选孩子年龄段，再从场景分类里挑最像的一项，最后看今天能做的小练习。</text>
  </view>
</view>
