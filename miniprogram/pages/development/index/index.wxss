.page {
  min-height: 100vh;
  background: #FAF6F3;
  padding-bottom: 40rpx;
}

.header {
  padding: 56rpx 32rpx 30rpx;
  background: linear-gradient(135deg, #3A2A22 0%, #6A412F 100%);
}

.eyebrow,
.title,
.subtitle,
.source-tip,
.zone-title,
.zone-subtitle,
.zone-meta,
.zone-action,
.guide-title,
.guide-desc {
  letter-spacing: 0;
  overflow-wrap: break-word;
}

.eyebrow {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #FFE8D6;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 800;
}

.title {
  display: block;
  margin-top: 20rpx;
  font-size: 40rpx;
  line-height: 1.45;
  color: #FFFFFF;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(255, 250, 244, 0.86);
}

.source-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: rgba(255, 250, 244, 0.72);
}

.zone-grid {
  padding: 28rpx 32rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.featured-row {
  padding: 26rpx 32rpx 0;
}

.featured-label {
  display: block;
  color: #765247;
  font-size: 23rpx;
  font-weight: 900;
}

.featured-list {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.featured-item {
  flex: 1;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(74, 111, 227, 0.18);
}

.featured-title,
.featured-action {
  display: block;
}

.featured-title {
  color: #2F241F;
  font-size: 26rpx;
  font-weight: 900;
}

.featured-action {
  margin-top: 6rpx;
  color: #6F5B53;
  font-size: 20rpx;
  line-height: 1.5;
}

.zone-card {
  width: calc((100% - 18rpx) / 2);
  min-height: 210rpx;
  padding: 24rpx 22rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 2rpx solid rgba(255, 107, 53, 0.16);
  box-shadow: 0 8rpx 24rpx rgba(138, 72, 32, 0.06);
}

.zone-card:active {
  transform: scale(0.98);
}

.zone-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.zone-title {
  flex: 1;
  font-size: 29rpx;
  line-height: 1.45;
  color: #2F241F;
  font-weight: 900;
}

.zone-arrow {
  color: #D85C26;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 900;
}

.zone-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #6F5B53;
}

.zone-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(74, 111, 227, 0.12);
  color: #3F5FC7;
  font-size: 19rpx;
  font-weight: 800;
}

.zone-badge-premium {
  background: rgba(216, 92, 38, 0.12);
  color: #B44C22;
}

.zone-meta-row {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.zone-meta,
.zone-action {
  display: block;
  font-size: 21rpx;
  line-height: 1.45;
  font-weight: 800;
}

.zone-meta {
  color: #9A6E61;
}

.zone-action {
  color: #D85C26;
}

.guide-card {
  margin: 28rpx 32rpx 0;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(138, 72, 32, 0.06);
}

.guide-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.45;
  color: #2F241F;
  font-weight: 900;
}

.guide-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7A6660;
}
.pain-point-card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin: 24rpx 0; }
.filter-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 18rpx 0; }
.filter-chip { padding: 12rpx 18rpx; border-radius: 999rpx; background: #f2f7f7; color: #64747b; font-size: 24rpx; }
.filter-chip-active { background: #e5f7f3; color: #168c7c; }
.pain-point-item { min-height: 88rpx; padding: 20rpx 0; border-top: 1rpx solid #e5ecee; }
.pain-point-title, .pain-point-desc, .pain-point-link { display: block; }
.pain-point-title { color: #243238; font-weight: 600; }
.pain-point-desc { color: #64747b; font-size: 24rpx; margin-top: 8rpx; }
.pain-point-link { color: #168c7c; font-size: 23rpx; margin-top: 10rpx; }
