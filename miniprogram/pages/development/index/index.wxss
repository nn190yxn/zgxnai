.page {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 40rpx;
}

.header {
  margin: 24rpx 32rpx 0;
  padding: 40rpx 32rpx 30rpx;
  background: #E6F7ED;
  border: 1rpx solid #ECEFEB;
  border-radius: 28rpx;
}

.eyebrow,
.title,
.subtitle,
.source-tip,
.zone-title,
.zone-subtitle,
.zone-meta,
.zone-action,
.guide-title,
.guide-desc {
  letter-spacing: 0;
  overflow-wrap: break-word;
}

.eyebrow {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #397A68;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 800;
}

.title {
  display: block;
  margin-top: 20rpx;
  font-size: 40rpx;
  line-height: 1.45;
  color: #2F3432;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #626A66;
}

.source-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #929995;
}

.scene-section {
  margin: 26rpx 32rpx 0;
}

.scene-section-desc {
  display: block;
  margin-top: 8rpx;
  color: #929995;
  font-size: 24rpx;
  line-height: 1.55;
}

.family-scene-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.family-scene-item {
  min-height: 156rpx;
  padding: 22rpx;
  border: 1rpx solid #ECEFEB;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.family-scene-title,
.family-scene-desc {
  display: block;
}

.family-scene-title {
  color: #2F3432;
  font-size: 28rpx;
  font-weight: 700;
}

.family-scene-desc {
  margin-top: 8rpx;
  color: #626A66;
  font-size: 23rpx;
  line-height: 1.5;
}

.zone-grid {
  padding: 28rpx 32rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.featured-row {
  padding: 26rpx 32rpx 0;
}

.featured-label {
  display: block;
  color: #2F3432;
  font-size: 23rpx;
  font-weight: 900;
}

.featured-list {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.featured-item {
  flex: 1;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECEFEB;
}

.featured-title,
.featured-action {
  display: block;
}

.featured-title {
  color: #2F3432;
  font-size: 26rpx;
  font-weight: 900;
}

.featured-action {
  margin-top: 6rpx;
  color: #626A66;
  font-size: 20rpx;
  line-height: 1.5;
}

.zone-card {
  width: calc((100% - 18rpx) / 2);
  min-height: 210rpx;
  padding: 24rpx 22rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 1rpx solid #ECEFEB;
  box-shadow: none;
}

.zone-card:active {
  transform: scale(0.98);
}

.zone-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.zone-title {
  flex: 1;
  font-size: 29rpx;
  line-height: 1.45;
  color: #2F3432;
  font-weight: 900;
}

.zone-arrow {
  color: #397A68;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 900;
}

.zone-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #626A66;
}

.zone-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(74, 111, 227, 0.12);
  color: #3F5FC7;
  font-size: 19rpx;
  font-weight: 800;
}

.zone-badge-premium {
  background: rgba(216, 92, 38, 0.12);
  color: #B44C22;
}

.zone-meta-row {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.zone-meta,
.zone-action {
  display: block;
  font-size: 21rpx;
  line-height: 1.45;
  font-weight: 800;
}

.zone-meta {
  color: #9A6E61;
}

.zone-action {
  color: #397A68;
}

.guide-card {
  margin: 28rpx 32rpx 0;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.guide-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.45;
  color: #2F3432;
  font-weight: 900;
}

.guide-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #626A66;
}
.pain-point-card { background: #FFFFFF; border-radius: 20rpx; padding: 28rpx; margin: 24rpx 0; }
.filter-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 18rpx 0; }
.filter-chip { padding: 12rpx 18rpx; border-radius: 999rpx; background: #f2f7f7; color: #626A66; font-size: 24rpx; }
.filter-chip-active { background: #E6F7ED; color: #397A68; }
.pain-point-item { min-height: 88rpx; padding: 20rpx 0; border-top: 1rpx solid #ECEFEB; }
.pain-point-title, .pain-point-desc, .pain-point-link { display: block; }
.pain-point-title { color: #2F3432; font-weight: 600; }
.pain-point-desc { color: #626A66; font-size: 24rpx; margin-top: 8rpx; }
.pain-point-link { color: #397A68; font-size: 23rpx; margin-top: 10rpx; }
