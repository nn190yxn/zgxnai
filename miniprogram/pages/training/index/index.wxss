.training-page { padding-bottom: 60rpx; background: #F7F7F2; }
.today-card, .empty-card, .plan-item { margin: 24rpx 32rpx; padding: 32rpx; border-radius: 28rpx; background: #FFFFFF; border: 1rpx solid #DDE8E3; box-shadow: 0 10rpx 30rpx rgba(54, 83, 75, 0.08); }
.eyebrow, .task-meta { display: block; color: #9d8172; font-size: 24rpx; }
.task-title { display: block; margin: 14rpx 0; color: #283936; font-size: 38rpx; font-weight: 700; }
.task-objective { display: block; color: #657773; font-size: 28rpx; line-height: 1.6; }
.section-title { margin: 36rpx 32rpx 16rpx; color: #283936; font-size: 30rpx; font-weight: 700; }
.plan-actions { display: flex; gap: 12rpx; padding: 0 32rpx; }
.plan-actions button { flex: 1; margin: 0; color: #fff; background: #2F9D8E; border-radius: 18rpx; font-size: 25rpx; }
.plan-item { display: flex; justify-content: space-between; color: #66534a; font-size: 25rpx; }
