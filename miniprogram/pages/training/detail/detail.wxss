.training-detail-page { padding-bottom: 60rpx; }
.detail-card, .feedback-card { margin: 24rpx 32rpx; padding: 32rpx; border-radius: 24rpx; background: #fffaf5; }
.eyebrow, .safety { display: block; color: #9d8172; font-size: 24rpx; }
.detail-title { display: block; margin: 12rpx 0; color: #392a25; font-size: 40rpx; font-weight: 600; }
.detail-objective, .step, .prompt, .signal { display: block; margin-top: 12rpx; color: #66534a; font-size: 28rpx; line-height: 1.6; }
.detail-section { margin-top: 28rpx; }
.detail-label { display: block; color: #392a25; font-size: 28rpx; font-weight: 600; }
.complete-button, .feedback-card button { margin-top: 28rpx; color: #fff; background: #d46c4b; }
.feedback-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.feedback-option { padding: 14rpx 20rpx; border: 1rpx solid #ead8ce; border-radius: 30rpx; color: #66534a; font-size: 25rpx; }
.feedback-option.active { color: #fff; border-color: #d46c4b; background: #d46c4b; }
textarea { box-sizing: border-box; width: 100%; height: 140rpx; margin-top: 24rpx; padding: 18rpx; border: 1rpx solid #ead8ce; border-radius: 14rpx; background: #fff; }
