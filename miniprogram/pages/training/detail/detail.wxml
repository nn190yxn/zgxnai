<view class="page training-detail-page">
  <view wx:if="{{task}}" class="detail-card"><text class="eyebrow">第{{task.dayIndex}}天 · {{task.durationMinutes}}分钟</text><text class="detail-title">{{task.title}}</text><text class="detail-objective">目标：{{task.objective}}</text>
    <view class="detail-section"><text class="detail-label">动作步骤</text><text wx:for="{{task.steps}}" wx:key="*this" class="step">{{index + 1}}. {{item}}</text></view>
    <view class="detail-section"><text class="detail-label">家长可以这样说</text><text class="prompt">{{task.parentPrompt}}</text></view>
    <view class="detail-section"><text class="detail-label">观察什么</text><text wx:for="{{task.observeSignals}}" wx:key="*this" class="signal">{{item}}</text></view>
    <text class="safety">安全提示：{{task.safetyNotice}}</text>
    <button class="complete-button" bindtap="completeTask">{{task.completed ? '已完成' : (submitting ? '保存中...' : '标记完成')}}</button>
    <text wx:if="{{syncMessage}}" class="sync-status sync-{{syncStatus}}">{{syncMessage}}</text>
  </view>
  <view class="feedback-card"><text class="detail-label">今天陪练得怎么样？</text><view class="feedback-list"><view wx:for="{{feedbackOptions}}" wx:key="key" class="feedback-option {{selectedFeedback === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectFeedback">{{item.label}}</view></view><textarea placeholder="补充一句观察（可选）" value="{{note}}" bindinput="onNoteInput"></textarea><button bindtap="submitFeedback">保存家长反馈</button></view>
  <view wx:if="{{nextSuggestion}}" class="feedback-card"><text class="detail-label">下一次建议</text><text>{{nextSuggestion}}</text></view>
</view>
