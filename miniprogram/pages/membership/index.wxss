/* pages/membership/index.wxss */
.membership-page {
  padding: 20rpx;
  background: #FAF8F5;
  min-height: 100vh;
}

.membership-state-card {
  padding: 32rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid #ECEFEB;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.membership-state-error {
  border-color: #F3DFE3;
}

.membership-state-title,
.membership-state-copy {
  display: block;
}

.membership-state-title {
  color: #2F3432;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
}

.membership-state-copy {
  margin-top: 12rpx;
  color: #626A66;
  font-size: 26rpx;
  line-height: 1.65;
}

.membership-state-button {
  margin-top: 24rpx;
  border-radius: 24rpx;
  color: #FFFFFF;
  background: #6AAE98;
  font-size: 28rpx;
}

.membership-fallback-notice {
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #ECEFEB;
  border-radius: 18rpx;
  color: #397A68;
  background: #E6F7ED;
  font-size: 24rpx;
  line-height: 1.6;
}

.membership-card {
  background: #E6F7ED;
  border: 1rpx solid #ECEFEB;
  box-shadow: none;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  color: #2F3432;
}

.membership-primary-card {
  padding: 32rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid #ECEFEB;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(106, 174, 152, 0.12);
}

.membership-primary-title,
.membership-primary-desc {
  display: block;
}

.membership-primary-title {
  color: #2F3432;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
}

.membership-primary-desc {
  margin-top: 12rpx;
  color: #626A66;
  font-size: 26rpx;
  line-height: 1.65;
}

.membership-primary-button,
.membership-return-button {
  margin-top: 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.membership-primary-button {
  color: #FFFFFF;
  background: #6AAE98;
}

.membership-return-button {
  margin-top: 16rpx;
  color: #397A68;
  border: 1rpx solid #ECEFEB;
  background: #FFFFFF;
}

.membership-header {
  margin-bottom: 20rpx;
}

.membership-title {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1.45;
}

.membership-status {
  margin-top: 10rpx;
}

.status-text {
  font-size: 28rpx;
  opacity: 0.9;
  line-height: 1.55;
}

.membership-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.membership-info {
  flex: 1;
}

.membership-type {
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1.45;
}

.membership-days {
  font-size: 28rpx;
  margin-top: 10rpx;
  opacity: 0.9;
  line-height: 1.55;
}

.membership-tip {
  display: block;
  font-size: 24rpx;
  margin-top: 12rpx;
  opacity: 0.9;
  line-height: 1.65;
}

.membership-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.btn-primary {
  background: #6AAE98;
  color: #FFFFFF;
  border: none;
  border-radius: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1.45;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.plans-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #2F3432;
  line-height: 1.45;
}

.plans-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.payment-compliance {
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #eef7f2;
  border: 2rpx solid #bfe7cc;
}

.payment-compliance-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #176b3a;
  line-height: 1.45;
  margin-bottom: 8rpx;
}

.payment-compliance-desc {
  display: block;
  font-size: 24rpx;
  color: #285f3c;
  line-height: 1.65;
}

.plan-item {
  border: 2rpx solid #ECEFEB;
  border-radius: 16rpx;
  padding: 30rpx;
  background: #FAF8F5;
}

.plan-selected {
  border-color: #6AAE98;
  background: #f0f4ff;
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.plan-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2F3432;
  line-height: 1.45;
}

.plan-duration {
  font-size: 24rpx;
  color: #929995;
  line-height: 1.45;
}

.plan-price {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.price-current {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
  line-height: 1.2;
}

.price-original {
  font-size: 28rpx;
  color: #929995;
  text-decoration: line-through;
  line-height: 1.45;
}

.plan-desc {
  font-size: 24rpx;
  color: #626A66;
  margin-bottom: 20rpx;
  line-height: 1.65;
}

.plan-auto-renew {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.renew-text {
  font-size: 24rpx;
  color: #626A66;
  line-height: 1.55;
}

.btn-pay {
  background: #E6F7ED;
  color: #FFFFFF;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 30rpx;
  line-height: 1.45;
}

.btn-pay-disabled {
  background: #ECEFEB;
  color: #FFFFFF;
}

.promo-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.promo-input {
  display: flex;
  gap: 20rpx;
}

.promo-input input {
  flex: 1;
  border: 2rpx solid #ECEFEB;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.btn-promo {
  background: #6AAE98;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.benefit-item {
  background: #f8f9ff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.benefit-item-active {
  background: #DDEDE5;
}

.benefit-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.benefit-title {
  display: block;
  font-size: 28rpx;
  color: #2F3432;
  font-weight: bold;
  line-height: 1.45;
}

.benefit-status {
  font-size: 22rpx;
  color: #F28C72;
  background: #F3DFE3;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.45;
}

.benefit-status-active {
  color: #2f8f46;
  background: #DDEDE5;
}

.benefit-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #626A66;
  line-height: 1.65;
}

.referral-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.referral-info {
  margin-bottom: 20rpx;
}

.referral-desc {
  font-size: 28rpx;
  color: #2F3432;
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.55;
}

.referral-limit {
  font-size: 24rpx;
  color: #929995;
  line-height: 1.55;
}

.referral-stats {
  display: flex;
  justify-content: space-around;
  margin: 30rpx 0;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #6AAE98;
  display: block;
  line-height: 1.3;
}

.stat-label {
  font-size: 24rpx;
  color: #626A66;
  line-height: 1.45;
}

.btn-share {
  background: #6AAE98;
  color: #FFFFFF;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1.45;
}

.recall-card {
  background: #6AAE98;
}

.recall-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.recall-urgent {
  background: rgba(255, 255, 255, 0.3);
}

.recall-soon {
  background: rgba(255, 255, 255, 0.2);
}

.badge-text {
  font-size: 22rpx;
  color: #FFFFFF;
  line-height: 1.45;
}

.recall-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  line-height: 1.45;
}

.recall-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}
