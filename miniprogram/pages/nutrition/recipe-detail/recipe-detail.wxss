/* 食谱详情页面样式 */

.page {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 40rpx;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #929995;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #626A66;
  line-height: 1.6;
}

/* 食谱头部 */
.recipe-header {
  position: relative;
}

.recipe-image {
  width: 100%;
  height: 500rpx;
}

.recipe-visual {
  background: #FAF8F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.recipe-visual::before {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -70rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 107, 53, 0.12);
}

.recipe-visual::after {
  content: '';
  position: absolute;
  left: -56rpx;
  bottom: -56rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(67, 160, 71, 0.1);
}

.recipe-visual-hero {
  width: 100%;
  height: 500rpx;
}

.recipe-visual-icon {
  font-size: 126rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.recipe-visual-title {
  margin-top: 22rpx;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 800;
  color: #7A4B2E;
  position: relative;
  z-index: 1;
}

.recipe-visual-subtitle {
  max-width: 560rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #A06A3A;
  text-align: center;
  line-height: 1.65;
  position: relative;
  z-index: 1;
}

.header-actions {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  box-shadow: none;
}

.action-btn.active {
  background: #FFEBEE;
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 20rpx;
  line-height: 1.45;
  color: #2F3432;
}

.share-btn {
  padding: 0;
  margin: 0;
  line-height: 1;
  background: rgba(255, 255, 255, 0.95);
}

.share-btn::after {
  border: none;
}

/* 基本信息区域 */
.info-section {
  background: #FFFFFF;
  padding: 32rpx;
  margin-top: -40rpx;
  border-radius: 32rpx 32rpx 0 0;
  position: relative;
}

.recipe-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2F3432;
  margin-bottom: 14rpx;
  line-height: 1.45;
}

.recipe-desc {
  display: block;
  font-size: 28rpx;
  color: #626A66;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.summary-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.summary-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #F3DFE3;
  color: #C85C23;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 600;
}

/* 营养标签 */
.nutrition-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.45;
  background: #F3DFE3;
  color: #6AAE98;
}

/* 基本信息 */
.basic-info {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #F9E3D6;
  border-radius: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 108rpx;
}

.info-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 22rpx;
  color: #929995;
  margin-bottom: 8rpx;
  line-height: 1.45;
}

.info-value {
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #2F3432;
}

/* 区块 */
.section {
  background: #FFFFFF;
  margin: 20rpx 32rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  box-shadow: none;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #2F3432;
}

.section-count {
  font-size: 24rpx;
  line-height: 1.45;
  color: #929995;
}

.section-action {
  font-size: 26rpx;
  line-height: 1.45;
  color: #6AAE98;
}

/* 营养分析卡片 */
.nutrition-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nutrition-highlight {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  background: #FAF8F5;
  border-radius: 20rpx;
}

.highlight-icon {
  font-size: 34rpx;
  line-height: 1;
}

.highlight-text {
  flex: 1;
  font-size: 28rpx;
  color: #7A4B2E;
  line-height: 1.7;
  font-weight: 500;
}

.nutrition-item {
  display: flex;
  align-items: center;
}

.nutrition-name {
  width: 160rpx;
  font-size: 26rpx;
  color: #626A66;
}

.nutrition-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: #ECEFEB;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.nutrition-bar {
  height: 100%;
  background: #6AAE98;
  border-radius: 8rpx;
}

.nutrition-bar.carbs {
  background: #F5E8BC;
}

.nutrition-bar.fat {
  background: #F28C72;
}

.nutrition-bar.fiber {
  background: #6AAE98;
}

.nutrition-value {
  width: 100rpx;
  text-align: right;
  font-size: 26rpx;
  color: #2F3432;
  font-weight: 500;
}

.nutrition-micronutrients,
.nutrition-combination,
.daily-nutrition,
.nutrition-tips {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FAFBFC;
}

.micronutrient-title,
.combination-title,
.daily-title {
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #2F3432;
  margin-bottom: 18rpx;
}

.micronutrient-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.micronutrient-item {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #EEF1F4;
}

.micronutrient-name {
  display: block;
  font-size: 24rpx;
  color: #8A8F98;
  margin-bottom: 10rpx;
  line-height: 1.45;
}

.micronutrient-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2F3432;
}

.combination-text,
.daily-text {
  display: block;
  font-size: 28rpx;
  color: #5C6470;
  line-height: 1.8;
}

.advice-points {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.advice-point {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #EEF1F4;
}

.advice-point-index {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #F28C72;
  background: #F3DFE3;
  flex-shrink: 0;
}

.advice-point-text {
  flex: 1;
  font-size: 26rpx;
  color: #5C6470;
  line-height: 1.7;
}

.warning-block {
  background: #FFF8F4;
}

/* 食材清单 */
.ingredient-list {
  display: flex;
  flex-direction: column;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ECEFEB;
}

.ingredient-item:last-child {
  border-bottom: none;
}

.ingredient-name {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
  font-size: 28rpx;
  color: #2F3432;
  line-height: 1.6;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.ingredient-amount {
  flex-shrink: 0;
  max-width: 38%;
  font-size: 28rpx;
  color: #626A66;
  line-height: 1.6;
  text-align: right;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.recipe-step-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recipe-step-item {
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.recipe-step-index {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #E6F7ED;
  color: #397A68;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.recipe-step-text {
  flex: 1;
  min-width: 0;
  color: #626A66;
  font-size: 28rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECEFEB;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0 32rpx env(safe-area-inset-bottom);
  box-shadow: none;
  z-index: 100;
}

.bar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.return-bar-btn {
  width: 112rpx;
  min-height: 76rpx;
  justify-content: center;
  border: 1rpx solid #ECEFEB;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.bar-primary-action {
  flex: 1;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #6AAE98;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(106, 174, 152, 0.12);
}

.bar-btn.active .bar-icon {
  color: #E53935;
}

.bar-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}

.bar-text {
  font-size: 22rpx;
  color: #626A66;
  line-height: 1.45;
}

.share-btn {
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
}

.share-btn::after {
  border: none;
}

/* 底部占位 */
.bottom-placeholder {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
