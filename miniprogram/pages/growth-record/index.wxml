<view class="page">
  <view wx:if="{{!currentChild}}" class="empty-card">
    <text class="empty-title">先填孩子信息，再开始记录变化</text>
    <view class="primary-btn" bindtap="goToChildSetup">去完善档案</view>
  </view>

  <block wx:else>
    <view class="hero-card">
      <text class="hero-title">记录 {{currentChild.name}} 今天的变化</text>
      <text class="helper-copy">选好今天的状态，补充一句观察，之后更容易看见变化。</text>
      <picker mode="date" value="{{recordDate}}" bindchange="onDateChange">
        <view class="date-chip">{{recordDate}}</view>
      </picker>
    </view>

    <view class="growth-overview">
      <view class="growth-overview-card" bindtap="goToDevelopment">
        <text class="growth-overview-kicker">行动进度</text>
        <text class="growth-overview-title">{{sourceContext ? '记录这次尝试' : '选择今天的一步行动'}}</text>
        <text class="growth-overview-link">去功能页 ></text>
      </view>
      <view class="growth-overview-card" bindtap="focusObservation">
        <text class="growth-overview-kicker">观察记录</text>
        <text class="growth-overview-title">补充今天五项状态</text>
        <text class="growth-overview-link">开始记录 ></text>
      </view>
      <view class="growth-overview-card" bindtap="goToWeeklySummary">
        <text class="growth-overview-kicker">周总结</text>
        <text class="growth-overview-title">看看本周行动与变化</text>
        <text class="growth-overview-link">查看总结 ></text>
      </view>
      <view class="growth-overview-card" bindtap="goToHistory">
        <text class="growth-overview-kicker">阶段变化</text>
        <text class="growth-overview-title">回看不同日期的记录</text>
        <text class="growth-overview-link">查看历史 ></text>
      </view>
    </view>

    <view id="observation-form" class="section-card" wx:for="{{sections}}" wx:key="field">
      <text class="section-title">{{item.title}}</text>
      <view class="option-list">
        <view
          class="option-chip {{form[item.field] === option.value ? 'option-chip-active' : ''}}"
          wx:for="{{item.options}}"
          wx:for-item="option"
          wx:key="value"
          data-field="{{item.field}}"
          data-value="{{option.value}}"
          bindtap="onPickStatus"
        >
          {{option.label}}
        </view>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">今天的补充记录</text>
      <textarea class="note-box" maxlength="500" placeholder="例如：午睡偏短，晚饭时情绪有点急，散步后稳定很多。" value="{{form.noteText}}" bindinput="onNoteInput"></textarea>
    </view>

    <view class="primary-btn {{saving ? 'primary-btn-disabled' : ''}}" bindtap="submitRecord">{{saving ? '保存中...' : '保存成长记录'}}</view>

    <view class="action-row">
      <view class="secondary-btn" bindtap="goToHistory">查看历史记录</view>
      <view class="secondary-btn" bindtap="goToWeeklySummary">查看成长总结</view>
    </view>
  </block>
</view>
