.page {
  min-height: 100vh;
  background: #FAF8F5;
  padding: 32rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.empty-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #ECEFEB;
}

.hero-title,
.section-title,
.empty-title {
  font-size: 32rpx;
  line-height: 1.45;
  color: #2F3432;
  font-weight: 700;
  word-break: break-word;
}

.hero-card .helper-copy {
  margin-top: 12rpx;
}

.source-action-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #ECEFEB;
  border-radius: 24rpx;
  background: #E6F7ED;
}

.source-action-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.source-action-kicker,
.source-action-status,
.source-action-title,
.source-action-desc {
  display: block;
  overflow-wrap: break-word;
}

.source-action-kicker {
  color: #397A68;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 700;
}

.source-action-status {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #397A68;
  font-size: 21rpx;
  line-height: 1.45;
}

.source-action-title {
  margin-top: 14rpx;
  color: #2F3432;
  font-size: 29rpx;
  line-height: 1.5;
  font-weight: 800;
}

.source-action-desc {
  margin-top: 10rpx;
  color: #626A66;
  font-size: 24rpx;
  line-height: 1.65;
}

.growth-overview {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.growth-overview-card {
  min-height: 188rpx;
  padding: 22rpx;
  border: 1rpx solid #ECEFEB;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.growth-overview-kicker,
.growth-overview-title,
.growth-overview-link {
  display: block;
}

.growth-overview-kicker {
  color: #397A68;
  font-size: 22rpx;
  font-weight: 600;
}

.growth-overview-title {
  margin-top: 10rpx;
  color: #2F3432;
  font-size: 27rpx;
  line-height: 1.5;
  font-weight: 700;
}

.growth-overview-link {
  margin-top: 12rpx;
  color: #929995;
  font-size: 22rpx;
}

.date-chip {
  margin-top: 16rpx;
  display: inline-block;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #E6F7ED;
  color: #397A68;
  font-size: 24rpx;
  line-height: 1.45;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.option-chip {
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECEFEB;
  color: #626A66;
  font-size: 24rpx;
  line-height: 1.45;
  box-sizing: border-box;
  word-break: break-word;
}

.option-chip-active {
  background: #6AAE98;
  color: #FFFFFF;
}

.note-box {
  width: 100%;
  min-height: 180rpx;
  margin-top: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECEFEB;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.7;
  font-size: 26rpx;
  color: #2F3432;
}

.helper-copy {
  display: block;
  margin-top: 16rpx;
  color: #626A66;
  font-size: 24rpx;
  line-height: 1.7;
  word-break: break-word;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.primary-btn,
.secondary-btn {
  text-align: center;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.45;
  box-sizing: border-box;
  word-break: break-word;
}

.primary-btn {
  background: #6AAE98;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  border: 1rpx solid #6AAE98;
}

.primary-btn-disabled {
  opacity: 0.7;
}

.secondary-btn {
  flex: 1 1 260rpx;
  min-width: 0;
  background: #FFFFFF;
  color: #626A66;
  border: 1rpx solid #ECEFEB;
}
