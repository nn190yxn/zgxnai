.page {
  min-height: 100vh;
  background: #F7F7F2;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.empty-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.hero-title,
.section-title,
.empty-title {
  font-size: 32rpx;
  line-height: 1.45;
  color: #2c2623;
  font-weight: 700;
  word-break: break-word;
}

.hero-card .helper-copy {
  margin-top: 12rpx;
}

.growth-overview {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.growth-overview-card {
  min-height: 188rpx;
  padding: 22rpx;
  border: 1rpx solid #E8EEEA;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.growth-overview-kicker,
.growth-overview-title,
.growth-overview-link {
  display: block;
}

.growth-overview-kicker {
  color: #2F8175;
  font-size: 22rpx;
  font-weight: 600;
}

.growth-overview-title {
  margin-top: 10rpx;
  color: #24332F;
  font-size: 27rpx;
  line-height: 1.5;
  font-weight: 700;
}

.growth-overview-link {
  margin-top: 12rpx;
  color: #7A8984;
  font-size: 22rpx;
}

.date-chip {
  margin-top: 16rpx;
  display: inline-block;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #E8F5F1;
  color: #2F8175;
  font-size: 24rpx;
  line-height: 1.45;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.option-chip {
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: #f3f0ec;
  color: #6c625b;
  font-size: 24rpx;
  line-height: 1.45;
  box-sizing: border-box;
  word-break: break-word;
}

.option-chip-active {
  background: #2F9D8E;
  color: #fff;
}

.note-box {
  width: 100%;
  min-height: 180rpx;
  margin-top: 16rpx;
  background: #faf7f3;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.7;
  font-size: 26rpx;
  color: #2c2623;
}

.helper-copy {
  display: block;
  margin-top: 16rpx;
  color: #6c625b;
  font-size: 24rpx;
  line-height: 1.7;
  word-break: break-word;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.primary-btn,
.secondary-btn {
  text-align: center;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.45;
  box-sizing: border-box;
  word-break: break-word;
}

.primary-btn {
  background: #2F9D8E;
  color: #fff;
  margin-bottom: 20rpx;
}

.primary-btn-disabled {
  opacity: 0.7;
}

.secondary-btn {
  flex: 1 1 260rpx;
  min-width: 0;
  background: #fff;
  color: #6c625b;
}
