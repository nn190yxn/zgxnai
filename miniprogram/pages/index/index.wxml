<view class="page">
  <view wx:if="{{startupSafeMode}}" class="safe-mode">
    <text class="safe-title">小牛育儿</text>
    <text class="safe-desc">今日内容正在准备</text>
    <text class="safe-note">请稍候片刻，内容准备好后会自动显示。</text>
  </view>

  <block wx:else>
    <view class="home-profile-bar">
        <image wx:if="{{currentChild && currentChild.avatar}}" class="home-profile-avatar" src="{{currentChild.avatar}}" mode="aspectFill" />
        <image wx:elif="{{currentChild && currentChild.gender === 'male'}}" class="home-profile-avatar" src="/images/generated/brand/brand-child-boy-placeholder.png" mode="aspectFill" />
        <image wx:elif="{{currentChild && currentChild.gender === 'female'}}" class="home-profile-avatar" src="/images/generated/brand/brand-child-girl-placeholder.png" mode="aspectFill" />
        <image wx:else class="home-profile-avatar" src="/images/generated/brand/brand-parent-placeholder.png" mode="aspectFill" />
      <view class="home-profile-copy">
        <text class="home-profile-name">{{currentChild ? (currentChild.name || currentChild.nickname || '当前孩子') : '欢迎来到小牛育儿'}}</text>
        <text class="home-profile-stage">{{currentChild ? '为孩子选择今天的一小步' : '先浏览内容，也可以完善孩子档案'}}</text>
      </view>
      <text class="home-profile-arrow">></text>
    </view>

    <view class="home-banner-section">
      <swiper class="home-banner" indicator-dots="true" autoplay="true" interval="4500" duration="500" circular="true">
        <swiper-item wx:for="{{bannerList}}" wx:key="action">
          <view class="home-banner-card" data-action="{{item.action}}" bindtap="onTapBannerCta">
            <image wx:if="{{item.image_url && !item.imageFailed}}" class="home-banner-image" src="{{item.image_url}}" mode="aspectFill" data-index="{{index}}" binderror="onBannerImageError" lazy-load="true" alt="{{item.alt_text || item.title}}" />
            <view class="home-banner-copy">
              <text class="home-banner-kicker">{{currentChild ? '为 ' + (currentChild.name || currentChild.nickname || '孩子') + ' 推荐' : '小牛育儿'}}</text>
              <text class="home-banner-title">{{item.title}}</text>
              <text class="home-banner-desc">{{item.desc}}</text>
              <text class="home-banner-cta">{{item.cta || '查看内容'}} ></text>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="home-primary-section">
      <view class="home-primary-card">
        <view class="home-primary-heading">
          <text class="home-primary-eyebrow">{{currentChild ? currentChild.name + ' 的今天' : '今天先从这里开始'}}</text>
          <text class="home-primary-status">{{homeState.recovered ? '已恢复本地记录' : '当前重点'}}</text>
        </view>
        <text class="home-primary-title">{{homePrimaryCard.title}}</text>
        <text class="home-primary-desc">{{homePrimaryCard.desc}}</text>
        <view class="home-primary-action" bindtap="onHomePrimaryActionTap">
          <text class="home-primary-action-text">{{homePrimaryCard.cta}}</text>
          <text class="home-primary-action-arrow">></text>
        </view>
      </view>
    </view>

    <view class="home-feature-section">
      <view class="home-section-heading">
        <text class="home-section-title">常用功能</text>
        <text class="home-section-subtitle">按需要选择，清楚看一项、做好一件事</text>
      </view>
      <view class="home-feature-grid">
        <view class="home-feature-item" wx:for="{{coreSupportTools}}" wx:key="key" data-action="{{item.action}}" bindtap="onCoreToolTap">
          <view class="home-feature-icon">
            <image class="home-feature-icon-image" src="{{item.iconPath}}" mode="aspectFit" />
          </view>
          <text class="home-feature-title">{{item.title}}</text>
          <text class="home-feature-desc">{{item.desc}}</text>
        </view>
      </view>
      <view class="home-feature-grid home-feature-grid-secondary">
        <view class="home-feature-item" wx:for="{{coreAuxiliaryTools}}" wx:key="key" data-action="{{item.action}}" bindtap="onCoreToolTap">
          <view class="home-feature-icon">
            <image class="home-feature-icon-image" src="{{item.iconPath}}" mode="aspectFit" />
          </view>
          <text class="home-feature-title">{{item.title}}</text>
          <text class="home-feature-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="home-topic-section" wx:if="{{developmentZones.length}}">
      <view class="home-section-heading">
        <text class="home-section-title">重点专题</text>
        <text class="home-section-subtitle">从一个具体场景开始，找到适合家庭的支持</text>
      </view>
      <view class="home-topic-list">
        <view class="home-topic-card" wx:for="{{developmentZones}}" wx:key="code" data-zone="{{item.code}}" bindtap="goToAllDevelopmentZones">
          <text class="home-topic-title">{{item.title}}</text>
          <text class="home-topic-desc">{{item.subtitle}}</text>
          <text class="home-topic-link">查看专题 ></text>
        </view>
      </view>
    </view>

    <view class="home-legacy-compat" hidden="true">
    <view class="core-hero" wx:if="{{coreRefactorEnabled}}">
      <view class="core-hero-content">
        <text class="core-brand">小牛育儿</text>
        <text class="core-status-eyebrow">孩子的成长观察</text>
        <text class="core-title">{{homePrimaryCard.title}}</text>
        <text class="core-desc">{{homePrimaryCard.desc}}</text>
        <view class="core-primary-action" bindtap="onHomePrimaryActionTap">
          <text class="core-primary-action-text">{{homePrimaryCard.cta}}</text>
        </view>
      </view>
    </view>

    <view class="core-status-card">
      <view class="core-status-header">
        <view>
          <text class="core-status-eyebrow">当前关注点</text>
          <text class="core-status-title">{{growthStatus.currentFocus}}</text>
        </view>
        <text class="core-status-progress">{{dailyPlanCompletedCount}}/{{dailyPlanCards.length || 0}} 项</text>
      </view>
      <text class="core-status-desc">{{growthStatus.todaySuggestion}}</text>
    </view>

    <view wx:if="{{showLegacyHomeSections}}" class="legacy-home-sections">
      <text class="legacy-home-sections-text">更多家庭内容</text>
    </view>

    <view class="core-today-card">
      <view class="core-today-header">
        <view>
          <text class="core-today-eyebrow">今天的主行动</text>
          <text class="core-today-title">完成一个短行动，留下一个观察</text>
        </view>
        <text class="core-today-count">{{dailyPlanCompletedCount}}/{{dailyPlanCards.length || 0}}</text>
      </view>
      <view wx:if="{{dailyPlanLoading}}" class="plan-loading-card">
        <text class="plan-loading-title">正在找今天适合做的事</text>
        <text class="plan-loading-desc">会优先看孩子的年龄和档案。</text>
      </view>
      <view wx:elif="{{dailyPlanCards.length}}" class="core-today-task" bindtap="onDailyPlanTap" data-index="0">
        <text class="core-today-task-title">{{dailyPlanCards[0].title}}</text>
        <text class="core-today-task-desc">{{dailyPlanCards[0].reason}}</text>
        <text class="core-today-task-action">{{dailyPlanCards[0].actionText}}</text>
      </view>
      <view wx:else class="plan-empty-card" bindtap="goToTodayTask">
        <text class="plan-empty-title">{{todayTask.title}}</text>
        <text class="plan-empty-desc">{{dailyPlanEmptyText || todayTask.duration}}</text>
      </view>
    </view>

    <view class="core-scenes">
      <view class="core-scenes-header">
        <text class="core-scenes-title">按场景找问题</text>
        <text class="core-scenes-subtitle">从写作业、吃饭、睡前和亲子共读等日常表现开始</text>
        <text class="core-scenes-note">也可以按年龄找孩子问题：学习专注、情绪规则、运动体能、社交表达</text>
      </view>
      <view class="core-scene-grid" wx:if="{{coreRefactorState.stage === 'scene_select' || coreRefactorState.stage === 'idle'}}">
        <view class="core-scene-item {{coreRefactorState.activeScene === item.key ? 'core-scene-item-active' : ''}}" wx:for="{{coreScenes}}" wx:key="key" data-scene-key="{{item.key}}" bindtap="onCoreSceneTap">
          <text class="core-scene-name">{{item.label}}</text>
          <text class="core-scene-desc">{{item.description}}</text>
        </view>
      </view>

      <view class="core-age-panel" wx:if="{{ageFirstCoreEnabled && ageFirstCoreAvailable}}">
        <view class="core-age-header">
          <text class="core-age-title">孩子现在几岁？</text>
          <text class="core-age-subtitle" wx:if="{{coreRefactorState.profileAgeGroup}}">已按 {{coreRefactorState.profileAgeGroup.childName}} 的档案先选 {{coreRefactorState.profileAgeGroup.label}}</text>
          <text class="core-age-subtitle" wx:else>选择年龄，看到更贴合的成长表现</text>
        </view>
        <view class="core-age-options">
          <view class="core-age-option {{coreRefactorState.selectedAgeSegment && coreRefactorState.selectedAgeSegment.key === item.key ? 'core-age-option-active' : ''}}" wx:for="{{coreRefactorState.ageSegments}}" wx:key="key" data-segment-key="{{item.key}}" bindtap="onCoreAgeSegmentTap">
            <text class="core-age-option-text">{{item.label}}</text>
          </view>
        </view>
        <view class="core-profile-entry" bindtap="goToCoreChildProfile">
          <text class="core-profile-entry-text">完善孩子档案，让判断更贴合</text>
        </view>
      </view>

      <view class="core-age-panel" wx:if="{{!ageFirstCoreEnabled && coreRefactorState.stage === 'age_select' && coreRefactorState.selectedScene}}">
        <view class="core-age-header">
          <text class="core-age-title">{{coreRefactorState.selectedScene.label}}，孩子现在多大？</text>
          <text class="core-age-subtitle">同一个场景，不同年龄的第一步会不一样</text>
        </view>
        <view class="core-age-options">
          <view class="core-age-option {{coreRefactorState.selectedAgeGroup === item.key ? 'core-age-option-active' : ''}}" wx:for="{{coreRefactorState.ageOptions}}" wx:key="key" data-age-key="{{item.key}}" bindtap="onCoreAgeTap">
            <text class="core-age-option-text">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="core-pain-panel" wx:if="{{coreRefactorState.selectedAgeSegment && (coreRefactorState.stage === 'age_select' || coreRefactorState.stage === 'pain_point_select')}}">
        <view class="core-pain-header">
          <text class="core-pain-title">当前最像哪种表现？</text>
          <text class="core-pain-subtitle">选一个最像孩子今天状态的问题，小牛给你今晚做法</text>
        </view>
        <view class="core-pain-list" wx:if="{{!coreRefactorState.showAllPainPoints}}">
          <view class="core-pain-item {{coreRefactorState.selectedPainPoint && coreRefactorState.selectedPainPoint.key === item.key ? 'core-pain-item-active' : ''}}" wx:for="{{coreRefactorState.featuredPainPoints}}" wx:key="key" data-pain-point-key="{{item.key}}" bindtap="onCorePainPointTap">
            <text class="core-pain-name">{{item.title}}</text>
            <text class="core-pain-desc">{{item.description}}</text>
            <view class="core-pain-signs" wx:if="{{item.observableSigns && item.observableSigns.length > 0}}">
              <text class="core-pain-sign" wx:for="{{item.observableSigns}}" wx:for-item="sign" wx:key="*this">{{sign}}</text>
            </view>
            <view class="core-ability-tags" wx:if="{{item.abilityTags && item.abilityTags.length > 0}}">
              <text class="core-ability-tag" wx:for="{{item.abilityTags}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
        </view>
        <view class="core-pain-category-list" wx:else>
          <view class="core-pain-category {{coreRefactorState.recentPainCategoryKey === category.key ? 'core-pain-category-active' : ''}}" wx:for="{{coreRefactorState.painCategories}}" wx:key="key" wx:for-item="category">
            <view class="core-pain-category-header" data-category-key="{{category.key}}" bindtap="onCorePainCategoryTap">
              <text class="core-pain-category-title">{{category.label}}</text>
              <text class="core-pain-category-desc">{{category.description}}</text>
            </view>
            <view class="core-pain-list core-pain-list-compact">
              <view class="core-pain-item core-pain-item-compact" wx:for="{{category.painPoints}}" wx:key="key" data-pain-point-key="{{item.key}}" bindtap="onCorePainPointTap">
                <text class="core-pain-name">{{item.title}}</text>
                <text class="core-pain-desc">{{item.description}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="core-pain-more" wx:if="{{coreRefactorState.painPoints && coreRefactorState.painPoints.length > coreRefactorState.featuredPainPoints.length}}" bindtap="onToggleCorePainPointList">
          <text class="core-pain-more-text">{{coreRefactorState.showAllPainPoints ? '收起表现' : '查看更多表现'}}</text>
        </view>
      </view>

      <view class="core-symptom-panel" wx:if="{{coreRefactorState.stage === 'symptom_select' && coreRefactorState.selectedScene}}">
        <view class="core-symptom-header">
          <text class="core-symptom-title">{{coreRefactorState.selectedScene.question}}</text>
          <text class="core-symptom-subtitle">选最像今天家里发生的那个表现</text>
        </view>
        <view class="core-symptom-list">
          <view class="core-symptom-item {{coreRefactorState.selectedSymptomKey === item.key ? 'core-symptom-item-active' : ''}}" wx:for="{{coreRefactorState.selectedScene.symptoms}}" wx:key="key" data-symptom-key="{{item.key}}" bindtap="onCoreSymptomTap">
            <text class="core-symptom-name">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="core-result-card" wx:if="{{coreRefactorState.stage === 'bottleneck_result' && coreRefactorState.currentBottleneck}}">
        <view class="core-result-header">
          <text class="core-result-eyebrow">今晚可以先做</text>
          <text class="core-result-title">{{coreRefactorState.currentBottleneck.bottleneckTitle}}</text>
          <text class="core-result-desc">{{coreRefactorState.currentBottleneck.bottleneckText}}</text>
        </view>
        <view class="core-result-observe" wx:if="{{coreRefactorState.observableSigns && coreRefactorState.observableSigns.length > 0}}">
          <text class="core-result-observe-title">你可能看到</text>
          <text class="core-result-observe-item" wx:for="{{coreRefactorState.observableSigns}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="core-ability-tags core-result-abilities" wx:if="{{coreRefactorState.abilityTags && coreRefactorState.abilityTags.length > 0}}">
          <text class="core-ability-tag" wx:for="{{coreRefactorState.abilityTags}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="core-action-box">
          <text class="core-action-title">{{coreRefactorState.currentBottleneck.actionTitle}}</text>
          <view class="core-action-steps">
            <view class="core-action-step" wx:for="{{coreRefactorState.currentBottleneck.actionSteps}}" wx:key="index">
              <text class="core-action-step-index">{{index + 1}}</text>
              <text class="core-action-step-text">{{item}}</text>
            </view>
          </view>
        </view>
        <view class="core-result-actions">
          <view class="core-result-primary" bindtap="onCoreTryTonightTap"><text class="core-result-primary-text">我今晚试试</text></view>
          <view class="core-result-secondary" bindtap="onCoreAskDetailTap"><text class="core-result-secondary-text">继续问细节</text></view>
        </view>
        <view class="core-result-tertiary" bindtap="onSaveCoreActionToGrowthRecordTap"><text class="core-result-tertiary-text">记到成长记录</text></view>
      </view>
    </view>

    <view wx:if="{{false}}" class="section development-zone-section">
      <view class="section-header">
        <view>
          <text class="section-title">3-6 岁发展专区</text>
          <text class="section-subtitle development-zone-subtitle">语言、感统、专注力、大运动、情绪社交，每天一个小动作。</text>
        </view>
        <text class="section-header-link" bindtap="goToAllDevelopmentZones">进入专区</text>
      </view>
      <view class="development-zone-entry" bindtap="goToAllDevelopmentZones">
        <text class="development-zone-entry-title">8 个发展方向，一次看清</text>
        <text class="development-zone-entry-desc">按年龄进入语言发育、感统支持、专注力、大运动、情绪管理、社交能力、自信与适应、生活习惯，选择最像孩子当前表现的场景。</text>
        <view class="development-zone-tags">
          <text class="development-zone-tag">先选年龄</text>
          <text class="development-zone-tag">再选场景</text>
          <text class="development-zone-tag">每天 3 分钟</text>
        </view>
        <text class="development-zone-entry-action">进入 3-6 岁专区 ></text>
      </view>
    </view>

    <view class="core-tools" wx:if="{{coreRefactorEnabled}}">
      <view class="core-tools-header">
        <text class="core-tools-title">成长记录与辅助入口</text>
        <text class="core-tools-subtitle">记录今天的变化，也可以从内容和问答里继续找办法</text>
      </view>
      <view class="core-tool-grid">
        <view class="core-tool-item" wx:for="{{coreSupportTools}}" wx:key="key" data-action="{{item.action}}" bindtap="onCoreToolTap">
          <text class="core-tool-title">{{item.title}}</text>
          <text class="core-tool-desc">{{item.desc}}</text>
        </view>
      </view>

      <view class="core-effect-panel" wx:if="{{coreRefactorState.stage === 'effect_record' && coreRefactorState.currentAction}}">
        <view class="core-effect-header">
          <text class="core-effect-title">试过以后，孩子是什么反应？</text>
          <text class="core-effect-subtitle">选一个最接近的情况，帮小牛给出下一步建议</text>
        </view>
        <view class="core-effect-list">
          <view class="core-effect-item" wx:for="{{coreRefactorState.effectOptions}}" wx:key="key" data-effect-key="{{item.key}}" bindtap="onCoreEffectTap">
            <text class="core-effect-item-text">{{item.label}}</text>
          </view>
        </view>
      </view>
      <view class="core-tool-grid core-auxiliary-tools">
        <view class="core-tool-item" wx:for="{{coreAuxiliaryTools}}" wx:key="key" data-action="{{item.action}}" bindtap="onCoreToolTap">
          <text class="core-tool-title">{{item.title}}</text>
          <text class="core-tool-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="core-membership" wx:if="{{coreRefactorEnabled && membershipTouchpointVisible}}" bindtap="goToMembership">
      <text class="core-membership-eyebrow">连续陪伴</text>
      <text class="core-membership-title">{{membershipTouchpointTitle}}</text>
      <text class="core-membership-desc">{{membershipTouchpointDesc}}</text>
      <text class="core-membership-action">{{membershipTouchpointCta}}</text>
    </view>

    <view class="home-growth-service-section">
      <view class="home-section-heading">
        <text class="home-section-title">成长服务</text>
        <text class="home-section-subtitle">记录变化，回看每一步进步</text>
      </view>
      <view class="home-growth-service-card" bindtap="goToGrowthRecord">
        <view>
          <text class="home-growth-service-title">成长记录与周总结</text>
          <text class="home-growth-service-desc">把今天的观察留下来，慢慢看见孩子的变化</text>
        </view>
        <text class="home-growth-service-arrow">></text>
      </view>
      <view wx:if="{{membershipTouchpointVisible}}" class="home-growth-service-card home-membership-service-card" bindtap="goToMembership">
        <view>
          <text class="home-growth-service-title">{{membershipTouchpointTitle}}</text>
          <text class="home-growth-service-desc">{{membershipTouchpointDesc}}</text>
        </view>
        <text class="home-growth-service-arrow">></text>
      </view>
    </view>

    <view class="tips-card">
      <text class="tips-title">温馨提示</text>
      <text class="tips-content">本服务内容仅供家庭教育参考，不能替代专业评估或诊断。如对孩子发育有明显担忧，建议咨询医生或相关专业人员。</text>
    </view>
    </view>
  </block>
  <encouragement-popup visible="{{showEncouragementPopup}}" message="{{encouragementMessage}}" level="{{encouragementLevel}}" bind:confirm="onEncouragementConfirm" bind:cancel="onEncouragementCancel" />
</view>
