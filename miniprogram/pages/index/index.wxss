/* Hero区域 */
.hero {
  background: #FFFFFF;
  padding: 20rpx 0 12rpx;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: #EAF9F6;
  border-radius: 50%;
}

.hero-content {
  margin: 0 32rpx;
  min-height: 220rpx;
  padding: 30rpx 26rpx;
  border-radius: 24rpx;
  background: #EAF9F6;
  position: relative;
  z-index: 2;
}

.hero-image {
  display: block;
  width: calc(100% - 64rpx);
  height: 330rpx;
  margin: 8rpx 32rpx 24rpx;
  border-radius: 28rpx;
  background: #F1FBFA;
  box-shadow: 0 10rpx 28rpx rgba(42, 174, 155, 0.10);
  position: relative;
  z-index: 2;
}

.hero-image-placeholder {
