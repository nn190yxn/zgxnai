/* 首页样式 */

.page {
  min-height: 100vh;
  background: #F7F9FA;
  padding-bottom: 40rpx;
}

.home-banner-section,
.home-feature-section,
.home-topic-section {
  padding: 24rpx 32rpx 0;
}

.home-banner {
  height: 300rpx;
}

.home-banner-card {
  height: 260rpx;
  box-sizing: border-box;
  padding: 34rpx 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #FBE5D6 0%, #F5C7AD 100%);
  color: #24332F;
}

.home-banner-card:nth-child(2n) {
  background: linear-gradient(135deg, #E3F1EC 0%, #B9DED0 100%);
}

.home-banner-kicker,
.home-banner-title,
.home-banner-desc,
.home-banner-cta {
  display: block;
}

.home-banner-kicker {
  font-size: 22rpx;
  line-height: 1.45;
  color: #A85F43;
  font-weight: 700;
}

.home-banner-title {
  margin-top: 16rpx;
  font-size: 42rpx;
  line-height: 1.5;
  font-weight: 800;
}

.home-banner-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #53635D;
}

.home-banner-cta {
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #3E8872;
  font-weight: 800;
}

.home-section-heading {
  margin-bottom: 18rpx;
}

.home-section-title,
.home-section-subtitle,
.home-feature-title,
.home-feature-desc,
.home-topic-title,
.home-topic-desc,
.home-topic-link {
  display: block;
}

.home-section-title {
  font-size: 32rpx;
  line-height: 1.45;
  color: #24332F;
  font-weight: 800;
}

.home-section-subtitle {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8A9892;
}

.home-feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx 12rpx;
}

.home-feature-grid-secondary {
  margin-top: 20rpx;
}

.home-feature-item {
  min-width: 0;
  text-align: center;
}

.home-feature-icon {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto 12rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E7F3EE;
  color: #3E8872;
  font-size: 22rpx;
  line-height: 1.5;
  font-weight: 800;
}

.home-feature-item:nth-child(2n) .home-feature-icon {
  background: #FFF1E8;
  color: #A85F43;
}

.home-feature-title {
  font-size: 24rpx;
  line-height: 1.45;
  color: #354640;
  font-weight: 700;
}

.home-feature-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: #8A9892;
}

.home-topic-list {
  display: flex;
  gap: 18rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.home-topic-card {
  flex: 0 0 300rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8EEEA;
}

.home-topic-title {
  font-size: 27rpx;
  line-height: 1.45;
  color: #24332F;
  font-weight: 800;
}

.home-topic-desc {
  min-height: 66rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #64746D;
}

.home-topic-link {
  margin-top: 18rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #4F9B83;
  font-weight: 700;
}

.safe-mode {
  min-height: 100vh;
  padding: 120rpx 48rpx;
  box-sizing: border-box;
  background: #F7F9FA;
}

.safe-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #243238;
  line-height: 1.45;
}

.safe-desc {
  display: block;
  margin-top: 28rpx;
  font-size: 30rpx;
  color: #2AAE9B;
  font-weight: 700;
}

.safe-note {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #7A6660;
}

/* 核心重构首屏 */
.core-hero {
  padding: 32rpx 32rpx 28rpx;
  background: #F7F9FA;
}

.core-hero-content {
  padding: 34rpx 30rpx 30rpx;
  border-radius: 28rpx;
  background: #EAF9F6;
  border: 1rpx solid #D5F0EB;
  box-shadow: 0 10rpx 28rpx rgba(42, 174, 155, 0.08);
}

.core-brand {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #D4F2EC;
  color: #287F74;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 700;
}

.core-title {
  display: block;
  margin-top: 22rpx;
  font-size: 46rpx;
  line-height: 1.28;
  font-weight: 900;
  color: #243238;
}

.core-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: #64747B;
}

.core-primary-action {
  margin-top: 30rpx;
  min-height: 92rpx;
  border-radius: 20rpx;
  background: #2AAE9B;
  display: flex;
  align-items: center;
  justify-content: center;
}

.core-primary-action-text {
  font-size: 29rpx;
  line-height: 1.45;
  font-weight: 900;
  color: #FFFFFF;
}

.core-status-card {
  margin-top: 18rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(93, 62, 45, 0.08);
}

.core-status-header,
.core-today-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.core-status-eyebrow,
.core-today-eyebrow {
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  color: #B06B4C;
  font-weight: 800;
}

.core-status-title,
.core-today-title {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #2F241F;
  font-weight: 850;
}

.core-status-progress,
.core-today-count {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #FFF2E8;
  color: #2F8175;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 800;
}

.core-status-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7A6660;
}

.core-boundary-card {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #FFF8E8;
  border: 1rpx solid #F2D9A6;
}

.core-boundary-title,
.core-boundary-text {
  display: block;
}

.core-boundary-title {
  font-size: 22rpx;
  line-height: 1.45;
  color: #8A5A1F;
  font-weight: 800;
}

.core-boundary-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #7A6660;
}

.core-today-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid #DCEEEE;
  box-shadow: 0 10rpx 28rpx rgba(35, 62, 70, 0.06);
}

.core-today-eyebrow {
  color: #2AAE9B;
}

.core-today-title {
  color: #243238;
}

.core-today-count {
  background: #EAF9F6;
  color: #287F74;
}

.core-today-task {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #F7F9FA;
  border: 1rpx solid #E5ECEE;
}

.core-today-task-title,
.core-today-task-desc,
.core-today-task-action {
  display: block;
}

.core-today-task-title {
  font-size: 29rpx;
  line-height: 1.45;
  color: #243238;
  font-weight: 850;
}

.core-today-task-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.78);
}

.core-today-task-action {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #FFE7B8;
  font-weight: 800;
}

.core-scenes {
  margin-top: 26rpx;
}

.core-scenes-header {
  margin-bottom: 18rpx;
}

.core-scenes-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.45;
  color: #2F241F;
  font-weight: 850;
}

.core-scenes-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8F756C;
}

.core-scene-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.core-scene-item {
  min-height: 168rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid transparent;
  box-shadow: 0 8rpx 24rpx rgba(93, 62, 45, 0.07);
  box-sizing: border-box;
}

.core-scene-item-active {
  border-color: #2F8175;
  background: #FFF8F1;
}

.core-scene-name {
  display: block;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 850;
  color: #2F241F;
}

.core-scene-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #7A6660;
}

.core-age-panel {
  margin-top: 20rpx;
  padding: 24rpx 22rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(93, 62, 45, 0.07);
}

.core-age-header {
  margin-bottom: 18rpx;
}

.core-age-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 850;
  color: #2F241F;
}

.core-age-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8F756C;
}

.core-age-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.core-age-option {
  min-height: 76rpx;
  border-radius: 16rpx;
  background: #FFF8F1;
  border: 2rpx solid #F0DED2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.core-age-option-active {
  background: #2F241F;
  border-color: #2F241F;
}

.core-age-option-text {
  font-size: 26rpx;
  line-height: 1.45;
  color: #5F453B;
  font-weight: 800;
}

.core-age-option-active .core-age-option-text {
  color: #FFFFFF;
}

.core-profile-entry {
  margin-top: 18rpx;
  min-height: 72rpx;
  border-radius: 16rpx;
  background: #F3E6DB;
  display: flex;
  align-items: center;
  justify-content: center;
}

.core-profile-entry-text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #7A4D3A;
  font-weight: 800;
}

.core-age-summary {
  margin-top: 18rpx;
  padding: 24rpx 22rpx;
  border-radius: 20rpx;
  background: #F8F5EF;
  border: 2rpx solid #E9D7CF;
  box-sizing: border-box;
}

.core-age-summary-title {
  display: block;
  font-size: 29rpx;
  line-height: 1.45;
  color: #2F241F;
  font-weight: 900;
}

.core-age-summary-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #6F5A52;
}

.core-focus-tags,
.core-ability-tags,
.core-pain-signs,
.core-result-observe-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.core-focus-tags,
.core-pain-signs,
.core-ability-tags {
  margin-top: 16rpx;
}

.core-focus-tag,
.core-ability-tag,
.core-pain-sign,
.core-result-observe-item {
  max-width: 100%;
  min-height: 42rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 21rpx;
  line-height: 1.25;
  font-weight: 800;
  word-break: break-word;
}

.core-focus-tag {
  background: #FFFFFF;
  color: #7A4D3A;
  border: 2rpx solid #E9D7CF;
}

.core-pain-panel {
  margin-top: 20rpx;
}

.core-pain-header {
  margin-bottom: 14rpx;
}

.core-pain-title {
  display: block;
  font-size: 29rpx;
  line-height: 1.45;
  color: #2F241F;
  font-weight: 900;
}

.core-pain-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8F756C;
}

.core-pain-list {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 14rpx;
}

.core-pain-category-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.core-pain-category {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #F8F5EF;
  border: 2rpx solid #E9D7CF;
  box-sizing: border-box;
}

.core-pain-category-active {
  border-color: #2F8175;
  background: #FFF8F1;
}

.core-pain-category-header {
  margin-bottom: 14rpx;
}

.core-pain-category-title {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  color: #2F241F;
  font-weight: 900;
}

.core-pain-category-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8F756C;
}

.core-pain-list-compact {
  gap: 10rpx;
}

.core-pain-item {
  min-height: 190rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid transparent;
  box-shadow: 0 8rpx 24rpx rgba(93, 62, 45, 0.07);
  box-sizing: border-box;
}

.core-pain-item-compact {
  min-height: 132rpx;
  padding: 18rpx;
  box-shadow: none;
}

.core-pain-item-active {
  border-color: #2F8175;
  background: #FFF8F1;
}

.core-pain-name {
  display: block;
  font-size: 28rpx;
  line-height: 1.45;
  color: #2F241F;
  font-weight: 900;
}

.core-pain-name-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.core-pain-name-row .core-pain-name {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
}

.core-pain-category-tag {
  flex-shrink: 0;
  max-width: 150rpx;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: #EAF3F0;
  color: #38665A;
  font-size: 19rpx;
  line-height: 1.45;
  font-weight: 850;
  box-sizing: border-box;
  word-break: break-word;
}

.core-pain-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #6F5A52;
}

.core-pain-sign {
  background: #F3E6DB;
  color: #7A4D3A;
}

.core-ability-tag {
  background: #EAF3F0;
  color: #38665A;
}

.core-pain-more {
  min-height: 76rpx;
  margin-top: 16rpx;
  border-radius: 18rpx;
  border: 2rpx solid #2F8175;
  background: #FFF8F1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.core-pain-more-text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #B84618;
  font-weight: 900;
}

.core-symptom-panel {
  margin-top: 20rpx;
  padding: 24rpx 22rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(93, 62, 45, 0.07);
}

.core-symptom-header {
  margin-bottom: 18rpx;
}

.core-symptom-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 850;
  color: #2F241F;
}

.core-symptom-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8F756C;
}

.core-symptom-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.core-symptom-item {
  min-height: 78rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #FFF8F1;
  border: 2rpx solid #F0DED2;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.core-symptom-item-active {
  background: #2F241F;
  border-color: #2F241F;
}

.core-symptom-name {
  font-size: 26rpx;
  line-height: 1.45;
  color: #5F453B;
  font-weight: 800;
}

.core-symptom-item-active .core-symptom-name {
  color: #FFFFFF;
}

.core-result-card {
  margin-top: 20rpx;
  padding: 26rpx 22rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(93, 62, 45, 0.08);
}

.core-result-header {
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid #F0E3DA;
}

.core-result-eyebrow,
.core-action-eyebrow {
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  color: #2F8175;
  font-weight: 850;
}

.core-result-title {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  line-height: 1.45;
  color: #2F241F;
  font-weight: 900;
}

.core-result-context {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #7A4D3A;
  font-weight: 800;
}

.core-result-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #6F5A52;
}

.core-result-observe {
  margin-top: 20rpx;
  padding: 18rpx 18rpx;
  border-radius: 16rpx;
  background: #F8F5EF;
  border: 2rpx solid #E9D7CF;
}

.core-result-observe-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #7A4D3A;
  font-weight: 900;
}

.core-result-observe-item {
  background: #FFFFFF;
  color: #6F5A52;
  border: 2rpx solid #E9D7CF;
}

.core-result-abilities {
  margin-top: 16rpx;
}

.core-action-box {
  margin-top: 22rpx;
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: #FFF8F1;
}

.core-action-title {
  display: block;
  margin-top: 8rpx;
  font-size: 29rpx;
  line-height: 1.45;
  color: #2F241F;
  font-weight: 900;
}

.core-action-steps {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.core-action-step {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.core-action-step-index {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #2F241F;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  font-weight: 850;
}

.core-action-step-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.55;
  color: #5F453B;
}

.core-result-actions {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
}

.core-result-primary,
.core-result-secondary {
  min-height: 82rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.core-result-primary {
  background: #2F8175;
}

.core-result-secondary {
  background: #FFFFFF;
  border: 2rpx solid #E2CFC4;
}

.core-result-primary-text,
.core-result-secondary-text {
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 900;
}

.core-result-primary-text {
  color: #FFFFFF;
}

.core-result-secondary-text {
  color: #5F453B;
}

.core-result-tertiary {
  margin-top: 14rpx;
  min-height: 76rpx;
  border-radius: 18rpx;
