  font-size: 24rpx;
  line-height: 1.6;
  color: #64747B;
}

.hero-badge {
  display: inline-block;
  background: #D4F2EC;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #287F74;
  margin-bottom: 20rpx;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #243238;
  margin-bottom: 12rpx;
  line-height: 1.45;
}

.hero-desc {
  font-size: 26rpx;
  color: #64747B;
  line-height: 1.5;
}

.hero-actions {
  margin-top: 28rpx;
