/* 成长观察结果页样式 */

.page {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 40rpx;
}

.result-state-card { margin: 32rpx; padding: 48rpx 32rpx; border: 1rpx solid #ECEFEB; border-radius: 28rpx; background: #FFFFFF; }
.result-state-title, .result-state-copy { display: block; }
.result-state-title { color: #2F3432; font-size: 32rpx; font-weight: 700; }
.result-state-copy { margin-top: 14rpx; color: #626A66; font-size: 26rpx; line-height: 1.65; }
.result-state-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.result-state-actions button { margin: 0; padding: 16rpx 24rpx; border: 1rpx solid #6AAE98; border-radius: 24rpx; background: #6AAE98; color: #FFFFFF; font-size: 25rpx; line-height: 1.45; }
.result-state-actions .secondary { background: #FFFFFF; color: #397A68; }
.result-context-tip { margin: 24rpx 32rpx 0; padding: 18rpx 22rpx; border: 1rpx solid #ECEFEB; border-radius: 20rpx; background: #E6F7ED; color: #397A68; font-size: 24rpx; line-height: 1.55; }

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #ECEFEB;
  border-top-color: #6AAE98;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #888;
}

/* 报告头部 */
.report-header {
  position: relative;
  padding: 48rpx 32rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: #E6F7ED;
}

.header-content {
  position: relative;
  z-index: 1;
  padding-top: 20rpx;
}

.assessment-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  line-height: 1.45;
}

.child-name {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
  line-height: 1.45;
}

.completed-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 综合评分 */
.score-section {
  padding: 0 32rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.score-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.circle-bg {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
}

.circle-progress {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
}

.circle-inner {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-number {
  font-size: 56rpx;
  font-weight: 700;
  color: #2F3432;
  line-height: 1;
}

.score-unit {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

.level-badge {
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.time-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.time-label {
  font-size: 24rpx;
  color: #888;
}

.time-value {
  font-size: 26rpx;
  color: #2F3432;
  font-weight: 500;
}

/* 通用section */
.section {
  margin: 24rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: none;
}

.section-header {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #ECEFEB;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2F3432;
}

/* 维度得分 */
.dimensions-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dimension-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dimension-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dimension-name {
  font-size: 28rpx;
  color: #2F3432;
}

.dimension-score {
  font-size: 26rpx;
  color: #626A66;
  font-weight: 500;
}

.dimension-bar {
  height: 12rpx;
  background: #ECEFEB;
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 详细解读 */
.interpretation-card {
  background: #FAF8F5;
  border-radius: 16rpx;
  padding: 24rpx;
}

.disclaimer-section {
  border-left: 6rpx solid #FFB74D;
}

.disclaimer-card {
  background: #F5E8BC;
  border-radius: 16rpx;
  padding: 24rpx;
}

.disclaimer-text {
  font-size: 26rpx;
  color: #8A5A00;
  line-height: 1.7;
}

.interpretation-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
}

/* 个性化建议 */
.suggestions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.suggestion-icon {
  width: 48rpx;
  height: 48rpx;
  background: #6AAE98;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.suggestion-content {
  flex: 1;
}

.suggestion-title {
  display: block;
  font-size: 28rpx;
  color: #2F3432;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.suggestion-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.suggestion-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.suggestion-meta-tag {
  font-size: 20rpx;
  color: #F28C72;
  background: #F3DFE3;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* 训练方案 */
.plans-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plan-item {
  background: #FAF8F5;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #ECEFEB;
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.plan-name {
  font-size: 28rpx;
  color: #2F3432;
  font-weight: 600;
}

.plan-duration {
  font-size: 22rpx;
  color: #6AAE98;
  background: #F3DFE3;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.plan-desc {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.plan-action {
  font-size: 24rpx;
  color: #6AAE98;
  font-weight: 500;
}

/* 底部操作 */
.bottom-actions {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 32rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-btn .btn-icon {
  font-size: 40rpx;
}

.action-btn .btn-text {
  font-size: 24rpx;
  color: #626A66;
  line-height: 1.45;
}

/* 底部按钮 */
.bottom-buttons {
  display: flex;
  padding: 0 32rpx;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.btn-secondary {
  flex: 1;
  min-height: 88rpx;
  line-height: 1.45;
  text-align: center;
  font-size: 30rpx;
  color: #6AAE98;
  background: #FFFFFF;
  border: 2rpx solid #6AAE98;
  border-radius: 44rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
}

.btn-primary {
  flex: 1;
  min-height: 88rpx;
  line-height: 1.45;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #6AAE98;
  border-radius: 44rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
}

/* 年龄段专属解读 */
.age-context-card {
  background: #FAF8F5;
  border-radius: 16rpx;
  padding: 24rpx;
}

.age-context-row {
  margin-bottom: 20rpx;
}

.age-context-row:last-child {
  margin-bottom: 0;
}

.age-context-label {
  display: block;
  font-size: 24rpx;
  color: #F28C72;
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.45;
}

.age-context-text {
  display: block;
  font-size: 26rpx;
  color: #4f453f;
  line-height: 1.7;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  padding: 20rpx 32rpx;
}

.tip-text {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.6;
}

.membership-cta-section {
  margin: 0 32rpx 40rpx;
}

.membership-cta-card {
  background: #6AAE98;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
}

.cta-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.cta-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.cta-btn {
  display: inline-block;
  background: #FFFFFF;
  color: #6AAE98;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
}
