/* 成长观察样式 */

.page {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  background: #E6F7ED;
  border: 1rpx solid #ECEFEB;
  border-radius: 28rpx;
  padding: 48rpx 32rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: -30rpx;
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #2F3432;
  margin-bottom: 12rpx;
  line-height: 1.35;
  position: relative;
  z-index: 1;
}

.page-subtitle {
  font-size: 26rpx;
  color: #626A66;
  line-height: 1.6;
  position: relative;
  z-index: 1;
}

/* 当前孩子信息 */
.child-info {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  margin: -20rpx 32rpx 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: none;
  position: relative;
  z-index: 2;
}

.child-avatar {
  width: 80rpx;
  height: 80rpx;
  background: #E6F7ED;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.child-detail {
  flex: 1;
}

.child-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2F3432;
  margin-bottom: 4rpx;
  line-height: 1.45;
}

.child-age {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.history-entry {
  display: flex;
  align-items: center;
  background: #F3DFE3;
  min-height: 56rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  position: relative;
  box-sizing: border-box;
}

.history-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.history-text {
  font-size: 24rpx;
  color: #6AAE98;
  font-weight: 500;
  line-height: 1.45;
}

.history-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #FF5722;
  border-radius: 18rpx;
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.age-filter {
  background: #FFFFFF;
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: none;
}

.age-filter-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.age-filter-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2F3432;
  flex-shrink: 0;
  line-height: 1.45;
}

.age-filter-subtitle {
  font-size: 22rpx;
  color: #888;
  text-align: right;
  line-height: 1.55;
}

.age-scroll {
  width: 100%;
  white-space: nowrap;
}

.age-option {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  min-height: 60rpx;
  margin-right: 14rpx;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  background: #FAF8F5;
  color: #626A66;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
  box-sizing: border-box;
}

.age-option.active {
  background: #6AAE98;
  color: #FFFFFF;
  box-shadow: none;
}

/* 观察工具列表 */
.assessment-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.assessment-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: none;
  transition: all 0.3s;
}

.assessment-card:active {
  transform: scale(0.98);
  box-shadow: none;
}

.card-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  background: #F3DFE3;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-icon {
  font-size: 48rpx;
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2F3432;
  margin-bottom: 10rpx;
  line-height: 1.45;
}

.card-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 14rpx;
  line-height: 1.65;
}

.card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
  line-height: 1.45;
}

.count-tag {
  background: #F3DFE3;
  color: #6AAE98;
}

.time-tag {
  background: #F5E8BC;
  color: #F28C72;
}

.age-tag {
  background: #DDEDE5;
  color: #2E7D32;
}

.card-arrow {
  font-size: 30rpx;
  color: #bbb;
}

.empty-assessment {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  box-shadow: none;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #444;
  margin-bottom: 10rpx;
  line-height: 1.45;
}

.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
  line-height: 1.7;
}

.empty-action {
  margin-top: 22rpx;
  min-width: 144rpx;
  min-height: 60rpx;
  line-height: 1.45;
  border-radius: 8rpx;
  background: #2f7cf6;
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  box-sizing: border-box;
}

/* 底部提示 */
.footer-tip {
  padding: 40rpx 32rpx 20rpx;
  text-align: center;
}

.footer-text {
  display: block;
  font-size: 24rpx;
  color: #aaa;
  margin-bottom: 8rpx;
  line-height: 1.55;
}

.footer-subtext {
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.55;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 90%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  animation: modalIn 0.3s ease;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #E6F7ED;
  position: relative;
}

.modal-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.modal-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #397A68;
  line-height: 1.35;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #626A66;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
}

.modal-body {
  padding: 32rpx;
}

.intro-section {
  margin-bottom: 24rpx;
}

.intro-label {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 8rpx;
  line-height: 1.45;
}

.intro-text {
  font-size: 30rpx;
  color: #2F3432;
  line-height: 1.6;
}

.intro-info {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.info-item {
  flex: 1 1 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FAF8F5;
  padding: 20rpx;
  border-radius: 16rpx;
}

.info-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 4rpx;
  line-height: 1.45;
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #2F3432;
  line-height: 1.45;
}

.intro-tips {
  background: #F5E8BC;
  padding: 24rpx;
  border-radius: 16rpx;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #F28C72;
  margin-bottom: 12rpx;
  line-height: 1.45;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #626A66;
  line-height: 1.7;
}

.modal-footer {
  display: flex;
  padding: 0 32rpx 32rpx;
  gap: 24rpx;
}

.btn-cancel {
  flex: 1;
  min-height: 88rpx;
  line-height: 1.45;
  text-align: center;
  font-size: 30rpx;
  color: #626A66;
  background: #FAF8F5;
  border-radius: 44rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
}

.btn-confirm {
  flex: 1;
  min-height: 88rpx;
  line-height: 1.45;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #6AAE98;
  border-radius: 44rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
}
