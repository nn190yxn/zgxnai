/* 答题页面样式 */

.page {
  min-height: 100vh;
  background: #FAF8F5;
  display: flex;
  flex-direction: column;
}

/* 顶部进度条 */
.progress-header {
  background: #FFFFFF;
  border: 1rpx solid #ECEFEB;
  padding: 24rpx 32rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: none;
}

.progress-bar {
  height: 12rpx;
  background: #ECEFEB;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: #6AAE98;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-text {
  font-size: 26rpx;
  color: #626A66;
  font-weight: 500;
}

.time-text {
  font-size: 26rpx;
  color: #6AAE98;
  font-weight: 600;
}

/* 题目卡片 */
.question-card {
  flex: 1;
  background: #FFFFFF;
  margin: 24rpx 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: none;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #ECEFEB;
}

.question-number {
  font-size: 28rpx;
  color: #6AAE98;
  font-weight: 600;
}

.assessment-name {
  font-size: 24rpx;
  color: #929995;
  background: #FAF8F5;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.question-content {
  margin-bottom: 32rpx;
}

.question-text {
  font-size: 34rpx;
  color: #2F3432;
  line-height: 1.6;
  font-weight: 500;
}

.question-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #929995;
  line-height: 1.65;
}

/* 选项列表 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 24rpx;
  background: #FAF8F5;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.option-item:active {
  transform: scale(0.98);
}

.option-item.selected {
  background: #F3DFE3;
  border-color: #6AAE98;
}

.option-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #CCC;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s;
}

.option-item.selected .option-radio {
  border-color: #6AAE98;
}

.radio-inner {
  width: 24rpx;
  height: 24rpx;
  background: #6AAE98;
  border-radius: 50%;
}

.option-text {
  font-size: 30rpx;
  color: #2F3432;
  line-height: 1.6;
}

.option-content {
  flex: 1;
  min-width: 0;
}

.option-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #929995;
  line-height: 1.6;
}

.option-item.selected .option-text {
  color: #6AAE98;
  font-weight: 500;
}

/* 题目导航点 */
.question-nav {
  background: #FFFFFF;
  padding: 16rpx 0;
  border-top: 1rpx solid #ECEFEB;
}

.nav-scroll {
  width: 100%;
}

.nav-dots {
  display: flex;
  padding: 0 32rpx;
  gap: 12rpx;
}

.nav-dot {
  min-width: 56rpx;
  height: 56rpx;
  background: #FAF8F5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #929995;
  flex-shrink: 0;
  transition: all 0.3s;
}

.nav-dot.answered {
  background: #F3DFE3;
  color: #6AAE98;
}

.nav-dot.current {
  background: #6AAE98;
  color: #FFFFFF;
  font-weight: 600;
}

.nav-dot.current.answered {
  background: #6AAE98;
  color: #FFFFFF;
}

/* 底部导航按钮 */
.bottom-nav {
  display: flex;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border: 1rpx solid #ECEFEB;
  gap: 16rpx;
  box-shadow: none;
}

.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.nav-btn:active {
  transform: scale(0.98);
}

.exit-btn {
  width: 120rpx;
  background: #FAF8F5;
  color: #626A66;
  flex-direction: column;
  gap: 4rpx;
}

.exit-btn .btn-icon {
  font-size: 28rpx;
}

.exit-btn .btn-text {
  font-size: 22rpx;
}

.prev-btn {
  flex: 1;
  background: #FFFFFF;
  border: 2rpx solid #6AAE98;
  color: #6AAE98;
  gap: 8rpx;
}

.prev-btn.disabled {
  border-color: #CCC;
  color: #CCC;
}

.next-btn {
  flex: 1.5;
  background: #6AAE98;
  color: #FFFFFF;
  gap: 8rpx;
}

.next-btn .btn-text {
  font-size: 30rpx;
}

.next-btn .btn-icon {
  font-size: 28rpx;
}
