.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f7f3ec;
}

.summary-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
}

.summary-title {
  display: block;
  color: #2c2623;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}

.summary-copy {
  display: block;
  margin-top: 14rpx;
  color: #6c625b;
  font-size: 26rpx;
  line-height: 1.7;
}

.primary-btn {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #ff7a45;
  color: #fff;
  text-align: center;
  font-size: 28rpx;
}
